*/

macro test(pid, comm, ppid) {
  printf("%d %s %s %d\n", pid, comm, __builtin_comm, ppid);
}

macro test(arg0, arg1) {
  printf("%d %d\n", arg0, arg1);
}

begin {
  test(1, "rtoax", 2);
  test(1, 2);
}
