#!/bin/bpftrace

macro test(pid, __builtin_comm, ppid, $pid, _pid, flags) {
  printf("%d %s %s %d %d %d %d\n", pid, comm, __builtin_comm, ppid, $pid, _pid, flags);
}

macro test(a1, a2) {
  printf("a1 %d, a2 %d, pid %d\n", a1, a2, pid);
}

macro test(arg1) {
  test(arg1, 2);
}

begin {
  $p1 = 3;
  $p2 = 4;
  $c1 = "2";
  test(1, $c1, $p1, $p2, 5, 6);
//  test(1, 2);
//  test(1);
}
