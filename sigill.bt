/*
uprobe:/bin/bash:readline
{
	$bias = (uint64)0x55dfaf227000;

	printf("pid %d, %s, %lx, %lx(%s), <%s>\n", pid, comm, uaddr("ps1_prompt"),
		reg("ip"),
		usym(reg("ip")),
		str(arg0));
