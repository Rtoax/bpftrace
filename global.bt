#!/usr/bin/env bpftrace

config = {
  missing_probes = warn;
}

BEGIN {
	//global $g_a = 12;
	global $g_a: int32;
	global $g_b = 12;
	let $a = 12;
	let $b = 12;
	global $name = getopt("name", "Rong Tao");
}

tracepoint:syscalls:sys_enter_open,
tracepoint:syscalls:sys_enter_openat,
tracepoint:syscalls:sys_enter_openat2
{
	$g_a = 123;
	printf("$g_a = %d\n", $g_a);
	printf("$g_b = %d\n", $g_b);
	printf("$name = %s\n", $name);
}

END {
	$g_a = 1234;
	$g_b = 1234;
	let $x = 12;
	let $y = 12;
	printf("$g_a = %d\n", $g_a);
	printf("$g_b = %d\n", $g_b);
	printf("$name = %s\n", $name);
	//printf("$a = %d\n", $a);
	//printf("$b = %d\n", $b);
}
