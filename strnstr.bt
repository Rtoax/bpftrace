#!/bin/env bpftrace

BEGIN
{
	printf("%d\n", strnchr("hello", 1, 'c'));
}

tracepoint:syscalls:sys_enter_openat
/ strnstr(comm, "open", 5) >= 0 /
{
	printf("strnstr: %s %d %s\n", comm, pid, args->filename);
}

tracepoint:syscalls:sys_enter_openat
/ strstr(comm, "open") >= 0 /
{
	printf("strstr:  %s %d %s\n", comm, pid, args->filename);
}

tracepoint:syscalls:sys_enter_openat
/ strcmp(comm, "ls") == 0 /
{
	printf("strcmp:  %s %d %s\n", comm, pid, args->filename);
}

