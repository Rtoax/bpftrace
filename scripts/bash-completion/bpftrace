# bash completion of bpftrace(8)

_bpftrace_filedir()
{
  # bash-completion 2.11-1091-g6e8a1546bde2 rename _filedir to _comp_compgen_filedir
  if [[ ${BASH_COMPLETION_VERSINFO[0]} == 2 ]] && \
     [[ ${BASH_COMPLETION_VERSINFO[1]} > 11 ]]; then
    _comp_compgen_filedir "${@}"
  else
    _filedir "${@}"
  fi
}

_bpftrace()
{
  local cur prev words argument

  _init_completion -- "$@" || return

  local all_args='-B -f -o -e -h --help -I --include -l -p --dwarf-pid -c
                  --no-feature --usdt-file-activation --unsafe -q --quiet
                  --info -k --warnings -V --version --no-warnings -v --dry-run
                  --mode --test --bench --probe-filter --traceable-functions
                  -d --debug --debuginfo --emit-elf --emit-llvm'

  if [[ $cur == -* ]]; then
    argument=$cur
  fi

  case ${prev} in
  -B)
    COMPREPLY=( $(compgen -W "line full none" -- ${cur}) )
    return 0
    ;;
  -f)
    COMPREPLY=( $(compgen -W "text json" -- ${cur}) )
    return 0
    ;;
  -c)
    COMPREPLY=( $(compgen -c -- ${cur}) )
    return 0
    ;;
  --no-feature)
    # support for comma-separated lists, syntax:
    # --no-feature FEATURE[,FEATURE]

    local features=( kprobe_multi kprobe_session uprobe_multi )

    if [[ ${cur} ]]; then
      local prevfeatures=( $(echo ${cur} | tr ',' ' ') )
      local leftfeatures=( )

      for pf in ${features[@]}
      do
        if [[ ! " ${prevfeatures[@]} " =~ " ${pf} " ]]; then
          leftfeatures+=( ${pf} )
        fi
      done

      # cur end with ',', just complete left features.
      # for example "kprobe_multi,"
      if [[ ${cur:${#cur}-1} == , ]]; then
        local hints=( )
        for f in ${leftfeatures[@]}
        do
          hints+=( ${cur}${f} )
        done
        COMPREPLY=( $(compgen -W "${hints[*]}" -- ${cur}) )
      # if only one feature specified and cur not end with comma, in other
      # words, only half of the first parameter string was written.
      # for example "kprobe_"
      elif [[ ${#prevfeatures[@]} -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "${features[*]}" -- ${cur}) )
      # have written more than one feature.
      # for example: 'kprobe_multi,kprobe_'
      elif [[ ${#prevfeatures[@]} -gt 1 ]]; then
        # The last feature that needs to be completed, for example, 'kprobe_'
        local lastfeature=${prevfeatures[-1]}
        local hints=( )
        for f in ${leftfeatures[@]}
        do
          # The remaining features that have not yet been listed will be
          # considered as candidates.
          if [[ " ${f} " =~ " ${lastfeature}" ]]; then
            # Remove the last incomplete feature and add any unspecified
            # features.
            hints+=( ${cur:0:-${#lastfeature}}${f} )
          fi
        done
        if [[ ${hints} ]]; then
          COMPREPLY=( $(compgen -W "${hints[*]}" -- ${cur}) )
        fi
      fi
    else
      COMPREPLY=( $(compgen -W "${features[*]}" -- ${cur}) )
    fi
    return 0
    ;;
  -o | --include | --emit-elf | --emit-llvm | --traceable-functions | --debuginfo)
    _bpftrace_filedir
    return 0
    ;;
  --mode)
    COMPREPLY=( $(compgen -W "codegen compiler-bench bench test format" -- ${cur}) )
    return 0
    ;;
  -I)
    _bpftrace_filedir -d
    return 0
    ;;
  -p | --dwarf-pid)
    local PIDS=$(cd /proc && echo [0-9]*)
    COMPREPLY=( $(compgen -W "$PIDS" -- ${cur}) )
    return 0
    ;;
  -d | --debug)
    debug_stage=( all ast types codegen codegen-opt dis parse libbpf verifier )
    COMPREPLY=( $(compgen -W "${debug_stage[*]}" -- ${cur}) )
    return 0
    ;;
  -h | --help | -V | --version | --info)
    return
    ;;
  esac

  # bpftrace directly specifies the script, like: bpftrace a.bt
  if [[ ! ${argument} ]]; then
    _bpftrace_filedir
  else
    # Just drop -e,--probe-filter content completion, because it's very complex.
    if ([[ ${cur} == -* ]] || [[ -z ${cur} ]]) &&
       [[ ! " -e --probe-filter " =~ " ${prev} " ]]; then
      COMPREPLY=( $(compgen -W "${all_args}" -- ${cur}) )
      return
    fi
  fi
}

complete -F _bpftrace bpftrace
